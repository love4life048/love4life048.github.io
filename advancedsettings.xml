<?xml version="1.0" encoding="utf-8"?>
<advancedsettings>
    <network>
        <!-- Buffer tất cả nguồn internet (stream, remux, link trực tiếp) -->
        <buffermode>1</buffermode>

        <!-- Cache ~500 MB trong RAM (bytes) -->
        <memorysize>524288000</memorysize>   <!-- 500 MB -->

        <!-- Đọc nhanh hơn để lấp buffer cho 4K bitrate cao -->
        <readfactor>6</readfactor>

        <!-- Chunk size lớn giúp ổn định khi xem 4K REMUX -->
        <chunksize>2097152</chunksize>        <!-- 2 MB -->
    </network>

    <!-- Dùng RAM thay vì bộ nhớ trong -->
    <cache>
        <harddisk>false</harddisk>
    </cache>

    <!-- Giảm delay khi tua phim 4K -->
    <video>
        <delayafterseeking>0.05</delayafterseeking>
    </video>
</advancedsettings>
